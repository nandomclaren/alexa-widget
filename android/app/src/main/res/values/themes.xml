<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AlexaWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/widget_accent</item>
        <item name="colorPrimaryDark">@color/widget_accent</item>
        <item name="colorAccent">@color/widget_accent</item>
    </style>

    <style name="Theme.AlexaWidget.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/widget_accent</item>
        <item name="colorAccent">@color/widget_accent</item>
    </style>

</resources>
