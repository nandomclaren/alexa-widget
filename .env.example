# Domínio regional da Amazon usado pela sua conta/dispositivo Alexa
# (ex.: amazon.com, amazon.com.br, amazon.fr, amazon.de, amazon.co.uk, amazon.co.jp...).
# IMPORTANTE: precisa ser o domínio onde a API da lista de compras da Alexa
# realmente está disponível — nem todo marketplace tem. Antes de configurar,
# teste abrindo https://www.<domínio>/alexaquantum/sp/alexaShoppingList
# logado no navegador; se não carregar a sua lista, tente outro domínio
# (veja "Sua lista de compras 'sumiu': o marketplace certo" no README).
AMAZON_DOMAIN=amazon.fr

# Credenciais da conta Amazon associada ao(s) dispositivo(s) Alexa da família
AMAZON_EMAIL=seuemail@example.com
AMAZON_PASSWORD=sua-senha-aqui

# Opcional, mas recomendado: chave secreta TOTP (base32) da sua conta Amazon,
# a mesma usada para gerar códigos em um app autenticador (Google Authenticator,
# Authy etc). Se preenchido, o serviço gera o código 2FA sozinho ao reautenticar,
# sem precisar que você digite nada na interface — reduz bastante a manutenção.
# Deixe em branco se você não usa 2FA por app autenticador ou prefere digitar
# o código manualmente na interface quando pedido.
AMAZON_OTP_SECRET=

# Token usado para proteger esta API (enviado como "Authorization: Bearer <token>").
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
BEARER_TOKEN=troque-este-valor

# Diretório onde os cookies de sessão e (se LOGIN_DEBUG=true) arquivos de
# depuração são salvos. No Docker isso é montado como volume (veja docker-compose.yml).
DATA_DIR=/data

# ID da lista de compras padrão da Alexa (a que os comandos de voz
# alimentam de verdade — não confunda com uma Lista de desejos criada
# manualmente). Descubra o valor abrindo o DevTools → Network no navegador
# em /alexaquantum/sp/alexaShoppingList: aparece na URL da chamada
# POST /alexashoppinglists/api/addlistitem/<este id> ao adicionar um item,
# ou como chave do JSON devolvido por GET /alexashoppinglists/api/getlistitems.
# Veja o passo a passo completo no README.
AMAZON_SHOPPING_LIST_ID=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Grava HTML das páginas de login da Amazon em DATA_DIR para depuração.
# Contém dados sensíveis da conta — mantenha "false" fora de depuração.
LOGIN_DEBUG=false
